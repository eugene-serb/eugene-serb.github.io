    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.27",
